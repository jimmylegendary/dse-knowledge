{
  "schema_version": "p0-cost-cases/v1",
  "description": "Pre-implementation deterministic oracle for chunk boundaries and monthly document Batch plus online query arithmetic; no runtime or provider calls were performed.",
  "runtime_status": "not_run",
  "chunking_defaults": {
    "chunk_size_tokens": 512,
    "overlap_tokens": 64,
    "input_constraints": "document_tokens >= 0 and 0 <= overlap_tokens < chunk_size_tokens",
    "chunk_count_rule": "0 when document_tokens is 0; otherwise 1 + ceil(max(0, document_tokens - chunk_size_tokens) / (chunk_size_tokens - overlap_tokens))",
    "document_input_rule": "0 when chunk_count is 0; otherwise document_tokens + overlap_tokens * (chunk_count - 1)"
  },
  "monthly_cost_rule": "((document_batch_tokens + retry_document_tokens + reembed_document_tokens) / 1000000 * document_batch_rate_usd_per_million) + (online_query_tokens / 1000000 * online_query_rate_usd_per_million)",
