      "expected_execution_permission": "not_applicable",
      "runtime_status": "not_run",
      "inputs": {"document_tokens": 0, "chunk_size_tokens": 512, "overlap_tokens": 64},
      "expected": {"chunk_count": 0, "document_input_tokens": 0}
    },
