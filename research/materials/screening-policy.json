{
  "policy_id": "dse-title-head-context-v3.1",
  "screening_model": {
    "method": "rule_based_contextual_keyword_screen",
    "honesty": "Contextual title/head rules, domain sense gates and independent sample audit; not individual LLM/human review.",
    "title_weight": 2,
    "abstract_weight": 1,
    "min_abstract_chars": 180,
    "min_title_chars": 12,
    "eligible_min_domain_score": 5,
    "core_term_required": true,
    "core_weight": 3,
    "off_field_max_score_without_cs": 7,
    "decision_rule": [
      "pending unless an actually observed head has at least180characters and an identifying title",
      "match terms case-insensitively in title and approximately ten wrapped lines of observed head",
      "require domain score >=5 and at least one weight3 core term; title weight2, head weight1",
      "enforce domain-specific computing sense: CPU/GPU/circuit context for hardware; neural/language-model context for model methods; software/server/compute context for serving",
      "reject generic attention in control theory as an LLM signal and parallel radio relays as compute serving",
      "do not reject hardware just because it is applied to a medical workload",
      "final registrar rejects source directories/search-query URLs, repairs generic titles from observed document paths, and merges stable material identifiers",
      "supporting optimization and model-method literature is a collection target, not an accepted physical constraint"
    ],
    "computing_context_required": true,
    "computing_context_terms": [
      "accelerator",
      "architecture",
      "asic",
      "bandwidth",
      "benchmark",
