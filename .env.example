# Design-only configuration contract. No config loader or provider adapter exists yet.
# Copy outside the public repository when preparing real runtime secrets.
# Blank values are intentionally unresolved; this file does not connect any service.
# *_REF uses the proposed env:VARIABLE_NAME syntax, never a secret value.
# See docs/infra-and-credential-requirements.md for required vs conditional fields.

# Existing Supabase project. DB credentials are needed only at actual connection time.
SUPABASE_PROJECT_REF=
SUPABASE_DB_MODE=
SUPABASE_AUTH_MODE=
SUPABASE_DB_URL_REF=env:SUPABASE_DB_URL
SUPABASE_DB_URL=
# Separate development schema/namespace are proposals, not created resources.
SUPABASE_DB_SCHEMA=dse_knowledge
DSE_NAMESPACE=dev
# Optional connection components; not additionally required when a DSN is supplied.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
# Optional alternatives when the detailed connection design selects them.
SUPABASE_DB_PASSWORD_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY_REF=
SUPABASE_PUBLISHABLE_KEY=

# Current Linux host. Set absolute storage paths; directories are not created here.
DSE_SERVICE_MODE=
DSE_SERVICE_USER=
DSE_DATA_ROOT=
DSE_ARTIFACT_ROOT=
DSE_MODEL_CACHE_ROOT=
DSE_LOG_ROOT=
DSE_BACKUP_ROOT=
# Conservative starting proposal; throughput and memory use have not been measured.
DSE_CPU_WORKERS=2
DSE_BIND_HOST=127.0.0.1
DSE_ALLOWED_CIDRS=

# Generation/reasoning interface: openrouter or codex_cli.
# For codex_cli, HTTP endpoint/key fields are inapplicable; CLI auth is separate.
CHAT_PROVIDER=
CHAT_BASE_URL=
CHAT_MODEL_ID=
CHAT_AUTH_MODE=
CHAT_API_KEY_REF=
# Only needed if OpenRouter is selected for a real call. Do not commit a value.
OPENROUTER_API_KEY=

# Optional local Codex runner settings. Authentication mode is not yet selected.
CODEX_EXECUTABLE=codex
CODEX_AUTH_MODE=
CODEX_API_KEY_REF=
# Only for a future explicitly selected API-key auth route; no new key is requested.
CODEX_API_KEY=

# Embedding has its own capability and model space. Chat is not an embedding API.
# Candidates: local_cpu or remote_embedding; backend/model selection is pending.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=
EMBEDDING_AUTH_MODE=
EMBEDDING_API_KEY_REF=
# Optional secret slot for a selected remote embedding service.
DSE_EMBEDDING_API_KEY=

# Reranking is independent: local_cpu, remote_reranker, or disabled.
RERANKER_PROVIDER=
RERANKER_BASE_URL=
RERANKER_MODEL_ID=
RERANKER_AUTH_MODE=
RERANKER_API_KEY_REF=
# Optional secret slot for a selected remote reranking service.
DSE_RERANKER_API_KEY=
