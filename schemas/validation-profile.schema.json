{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimmylegendary/dse-knowledge/blob/docs/p0-episode-contracts/schemas/validation-profile.schema.json",
  "title": "DSE Validation Profile",
  "description": "Versioned complete deterministic validation and review contract. A result is scoped to this immutable profile version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "lifecycle", "scope", "required_rules", "required_inputs", "applicability_contract", "review_requirements", "coverage_requirements", "out_of_scope", "aggregation", "digest_contract", "profile_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "lifecycle": {"enum": ["draft", "frozen", "retired"]},
    "scope": {"$ref": "#/$defs/scope"},
    "required_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "required_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "applicability_contract": {"$ref": "#/$defs/applicabilityContract"},
    "review_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewRequirement"}},
    "coverage_requirements": {"$ref": "#/$defs/coverage"},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "aggregation": {"$ref": "#/$defs/aggregation"},
    "digest_contract": {"const": "canonical-json-v1-excluding-profile_digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "rule_examples": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["target_kind", "target_id", "target_revision", "workload_scope", "validity_conditions"],
      "properties": {
        "target_kind": {"enum": ["design_point", "hardware_asset", "system_configuration", "kernel_configuration"]},
        "target_id": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "minLength": 1},
        "workload_scope": {"type": "array", "items": {"type": "string"}},
        "validity_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "rule_version", "required", "applicability", "blocking_class", "required_evidence_types", "owner"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "rule_version": {"type": "string", "minLength": 1},
        "required": {"const": true},
        "applicability": {"$ref": "#/$defs/applicability"},
        "blocking_class": {"enum": ["execution_semantic", "physical_feasibility", "advisory"]},
        "required_evidence_types": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate_id", "predicate_version", "expression", "input_refs", "unknown_policy"],
      "properties": {
        "predicate_id": {"type": "string", "minLength": 1},
        "predicate_version": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string"}},
        "unknown_policy": {"const": "incomplete_unknown"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "schema_ref", "version", "snapshot_required", "missing_policy"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "schema_ref": {"type": "string", "format": "uri-reference"},
        "version": {"type": "string", "minLength": 1},
        "snapshot_required": {"const": true},
        "missing_policy": {"const": "incomplete_unknown"}
      }
    },
    "applicabilityContract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "version", "rule_set_is_complete", "resolution_states", "unknown_policy"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rule_set_is_complete": {"const": true},
        "resolution_states": {"const": ["applicable", "not_applicable", "unknown"]},
        "unknown_policy": {"const": "incomplete_unknown"}
      }
    },
    "reviewRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "seat", "minimum_responses", "abstention_policy", "required_for_validation", "blocks_exploration"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "seat": {"type": "string", "minLength": 1},
        "minimum_responses": {"type": "integer", "minimum": 1},
        "abstention_policy": {"enum": ["counts_as_incomplete", "allowed_with_recorded_reason"]},
        "required_for_validation": {"const": true},
        "blocks_exploration": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["denominator", "require_all_applicable_rules", "summary_is_non_authoritative", "allow_vacuous_pass", "required_input_coverage"],
      "properties": {
        "denominator": {"const": "all_profile_required_rules_after_resolved_applicability"},
        "require_all_applicable_rules": {"const": true},
        "summary_is_non_authoritative": {"const": true},
        "allow_vacuous_pass": {"const": false},
        "required_input_coverage": {"const": "all"}
      }
    },
    "aggregation": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregation_id", "version", "rule_order", "fail_result", "unknown_result", "pass_result", "not_evaluated_result", "not_applicable_requires_predicate"],
      "properties": {
        "aggregation_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rule_order": {"const": ["applicable_required_fail", "required_unknown_missing_error", "required_review_incomplete", "all_required_pass"]},
        "fail_result": {"const": "reject"},
        "unknown_result": {"const": "incomplete_unknown"},
        "pass_result": {"const": "validated_within_declared_scope"},
        "not_evaluated_result": {"const": "not_evaluated"},
        "not_applicable_requires_predicate": {"const": true}
      }
    }
  }
}
