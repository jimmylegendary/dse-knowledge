# Template only. Copy each section to its named owner-only file under
# ~/.config/dse-knowledge (mode 0700 directory; files mode 0600).

# database.env — administrator account used only by scripts/bootstrap-database.py
SUPABASE_DB_HOST=<supabase-pooler-host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<administrator-password-kept-private>
SUPABASE_DB_SSLMODE=verify-full
SUPABASE_DB_SSLROOTCERT=/absolute/path/to/existing-ca.pem
SUPABASE_DB_SCHEMA=dse_knowledge

# runtime-database.env — generated by bootstrap; do not copy admin credentials here
SUPABASE_DB_HOST=<supabase-pooler-host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=dse_knowledge_app.<project-ref>
SUPABASE_DB_PASSWORD=<generated-by-bootstrap-and-kept-private>
SUPABASE_DB_SSLMODE=verify-full
SUPABASE_DB_SSLROOTCERT=/absolute/path/to/existing-ca.pem
SUPABASE_DB_SCHEMA=dse_knowledge

# app.env
DSE_BIND_HOST=0.0.0.0
DSE_HTTP_PORT=8080
DSE_DATA_ROOT=/absolute/path/to/private/dse-knowledge-data
DSE_ARTIFACT_ROOT=/absolute/path/to/private/dse-knowledge-data/artifacts
DSE_WEB_ROOT=/absolute/path/to/repository/web
DSE_SOURCE_ALLOWED_HOSTS=
MELETE_USER_ID=dse-knowledge
MELETE_NAMESPACE=dse_knowledge

# llm.env — Codex CLI only; the process inherits HOME and CODEX_HOME unchanged
CHAT_PROVIDER=codex_cli
CHAT_MODEL_ID=gpt-6.1-sol
CHAT_REASONING_EFFORT=max
CODEX_CLI_PATH=/absolute/path/to/codex
CODEX_WORKDIR=/absolute/path/to/private/dse-knowledge-data/codex-runtime
CODEX_TIMEOUT_SECONDS=180

# embedding.env — DeepInfra EmbeddingGemma 2
EMBEDDING_PROVIDER=deepinfra
EMBEDDING_MODEL_ID=google/embeddinggemma-2
EMBEDDING_DIMENSIONS=768
DSE_EMBEDDING_API_KEY=<private-deepinfra-api-key>
# Socket timeouts; each accepts an integer 1..120. Defaults remain 25 seconds.
DSE_EMBEDDING_DOCUMENT_TIMEOUT_SECONDS=25
DSE_EMBEDDING_QUERY_TIMEOUT_SECONDS=25

DSE_EXTRACTION_BATCH_SIZE=1

DSE_EXTRACTION_SNIPPETS=4

DSE_EXTRACTION_SNIPPET_CHARS=900

DSE_EXTRACTION_CLAIMS_PER_MATERIAL=1

# Structured reasoning calls stay bounded; 1..600 seconds.
CHAT_TIMEOUT_SECONDS=600

# contextual.env — private derived index and chunk-context provider
DSE_CONTEXTUAL_ENABLED=false
DSE_CONTEXT_INDEX_PATH=/absolute/path/to/private/dse-knowledge-data/contextual-index
DSE_CONTEXT_CHAT_BASE_URL=https://api.deepinfra.com/v1/openai
DSE_CONTEXT_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
DSE_CONTEXT_CHAT_API_KEY=<private-context-provider-api-key>
DSE_CONTEXT_CHAT_TIMEOUT_SECONDS=600

# rerank.env — Qwen3 Reranker; use a separate key from contextual.env
DSE_RERANK_ENABLED=false
DSE_RERANK_PROVIDER=deepinfra
DSE_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
DSE_RERANK_ENDPOINT=https://api.deepinfra.com/v1/inference/Qwen/Qwen3-Reranker-8B
DSE_RERANK_API_KEY=<private-reranker-api-key>
DSE_RERANK_ALLOW_HTTP=false
DSE_RERANK_TIMEOUT_SECONDS=120
DSE_RERANK_CANDIDATES=40

# app.env retrieval defaults; per-request mode overrides require explicit enablement
DSE_RETRIEVAL_MODE=baseline
DSE_RETRIEVAL_ALLOW_MODE_OVERRIDE=false
